---
---

<canvas id="circus-particles" aria-hidden="true"></canvas>
<button id="particles-toggle" class="particles-toggle" aria-pressed="false" aria-label="Pausar animación de confetti" type="button" title="Pausar animación">
  <span class="particles-toggle__icon" aria-hidden="true">⏸</span>
</button>

<style>
  #circus-particles {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.52;
  }
  .particles-toggle {
    position: fixed; bottom: 16px; left: 16px; z-index: 101;
    width: 38px; height: 38px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--c-surface); color: var(--c-white);
    border: 1px solid var(--c-border-strong);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .particles-toggle:hover{ background: var(--c-bg-700); transform: scale(1.05); }
  .particles-toggle__icon{ font-size: 13px; line-height: 1; }
  @media (prefers-reduced-motion: reduce){
    #circus-particles, .particles-toggle{ display:none !important; }
  }
  @media (max-width: 768px){
    .particles-toggle{ bottom: 14px; left: 14px; width:34px; height:34px; }
  }
</style>

<script is:inline>
(function(){
  const canvas = document.getElementById('circus-particles');
  const btn = document.getElementById('particles-toggle');
  if(!canvas) return;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ canvas.style.display='none'; if(btn) btn.style.display='none'; return; }
  const ctx = canvas.getContext('2d', { alpha: true });
  if(!ctx) return;

  const COLORS = ['#E63946','#4361EE','#FFD23F','#FFFFFF'];
  const SHAPES = ['circle','square','star'];
  let W, H, raf, paused = document.hidden;
  const DPR = Math.min(window.devicePixelRatio || 1, 2);

  function resize(){
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    canvas.style.width = W+'px'; canvas.style.height = H+'px';
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  function count(){
    if(W < 768) return 18;
    if(W < 1024) return 26;
    return 34;
  }
  function makeParticle(){
    const shape = SHAPES[Math.floor(Math.random()*SHAPES.length)];
    return {
      x: Math.random()*W,
      y: Math.random()*-H,
      r: 3 + Math.random()*5,
      c: COLORS[Math.floor(Math.random()*COLORS.length)],
      shape,
      vy: 0.35 + Math.random()*0.85,
      vx: (Math.random()-0.5)*0.55,
      rot: Math.random()*Math.PI*2,
      vr: (Math.random()-0.5)*0.022,
      sway: Math.random()*Math.PI*2,
      swaySpeed: 0.007 + Math.random()*0.012,
      swayAmp: 0.35 + Math.random()*0.75,
      opacity: 0.65 + Math.random()*0.35
    };
  }
  let particles = [];
  function init(){ particles = Array.from({length: count()}, makeParticle); }

  function drawStar(x,y,r,rot){
    ctx.save();
    ctx.translate(x,y); ctx.rotate(rot);
    ctx.beginPath();
    // 4 puntas simple
    for(let i=0;i<4;i++){
      ctx.rotate(Math.PI/2);
      ctx.moveTo(0,-r); ctx.lineTo(r*0.35,-r*0.35); ctx.lineTo(r,0); ctx.lineTo(r*0.35,r*0.35);
      ctx.lineTo(0,r); ctx.lineTo(-r*0.35,r*0.35); ctx.lineTo(-r,0); ctx.lineTo(-r*0.35,-r*0.35);
    }
    ctx.closePath(); ctx.fill();
    ctx.restore();
  }

  function frame(){
    if(paused){ raf = requestAnimationFrame(frame); return; }
    ctx.clearRect(0,0,W,H);
    for(const p of particles){
      p.y += p.vy;
      p.sway += p.swaySpeed;
      p.x += p.vx + Math.sin(p.sway)*p.swayAmp*0.05;
      p.rot += p.vr;
      if(p.y - p.r > H){ p.y = -12; p.x = Math.random()*W; }
      if(p.x < -20) p.x = W+10; if(p.x > W+20) p.x = -10;

      ctx.globalAlpha = p.opacity;
      ctx.fillStyle = p.c;
      if(p.shape==='circle'){
        ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
      } else if(p.shape==='square'){
        ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
        // leve 3D con sombra
        ctx.fillRect(-p.r,-p.r,p.r*2,p.r*2);
        ctx.restore();
      } else {
        drawStar(p.x,p.y,p.r,p.rot);
      }
    }
    ctx.globalAlpha = 1;
    raf = requestAnimationFrame(frame);
  }

  resize(); init(); frame();
  window.addEventListener('resize', () => { resize(); init(); }, { passive:true });
  document.addEventListener('visibilitychange', () => { paused = document.hidden; });

  // Toggle
  btn?.addEventListener('click', ()=>{
    paused = !paused;
    btn.setAttribute('aria-pressed', String(paused));
    btn.setAttribute('aria-label', paused ? 'Reanudar animación' : 'Pausar animación de confetti');
    btn.querySelector('.particles-toggle__icon').textContent = paused ? '▶' : '⏸';
    btn.title = paused ? 'Reanudar animación' : 'Pausar animación';
    if(!paused && !raf) frame();
  });

  // Respeta cambio dinámico de prefers-reduced-motion
  window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener?.('change', (ev)=>{
    if(ev.matches){
      paused = true;
      cancelAnimationFrame(raf);
      canvas.style.display='none';
      btn.style.display='none';
    } else {
      canvas.style.display='block';
      btn.style.display='grid';
      paused = false;
      resize(); init(); frame();
    }
  });
})();
</script>
