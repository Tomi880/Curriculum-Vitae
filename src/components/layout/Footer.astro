    <div class="footer__actions">
      <div class="footer__social">
        <a href="https://www.linkedin.com/in/tomas-ignacio-moreno-molina-242956224" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Tomás Moreno" class="footer__icon">
