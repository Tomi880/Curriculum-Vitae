<style>
  .hablemos { background: var(--c-bg-800); padding-top: 0; }
  .hablemos .divider-tricolor{ margin-bottom: var(--s-16); }
  .hablemos__header{ text-align:center; max-width: 640px; margin: 0 auto var(--s-10) auto; }
  .hablemos__title{
    font-family: var(--ff-display); font-size: var(--fs-h2); line-height:0.95;
    color: var(--c-white);
    text-shadow: 3px 3px 0 var(--c-bg-900), 6px 6px 0 rgba(0,0,0,0.35);
  }
  .hablemos__subtitle{ margin-top: var(--s-3); color: var(--c-muted); font-size:1.05rem; line-height:1.5; }
  .hablemos__subtitle strong{ color: var(--c-yellow); }
  .hablemos__grid{
    display:grid; grid-template-columns: 1fr; gap: var(--s-4);
    max-width: 860px; margin-inline:auto;
  }
  @media (min-width: 640px){ .hablemos__grid{ grid-template-columns: repeat(3, 1fr); } }
  .contact-card{
    display:flex; align-items:center; gap: var(--s-4);
    background: var(--c-surface); border:1px solid var(--c-border);
    border-radius: var(--r-card); padding: var(--s-5);
    transition: transform var(--dur-normal) var(--ease-out), border-color var(--dur-normal) var(--ease-out), box-shadow var(--dur-normal) var(--ease-out);
    cursor:pointer; text-decoration:none; color:inherit;
    position:relative; overflow:hidden;
  }
  .contact-card:hover{ transform: translateY(-3px); border-color: var(--c-border-strong); box-shadow: var(--shadow-card); }
  .contact-card--blue:hover{ border-color: rgba(67,97,238,0.5); box-shadow: 0 8px 32px rgba(67,97,238,0.18); }
  .contact-card--yellow{ background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-bg-900); }
  .contact-card--yellow .contact-card__text span{ color: rgba(10,10,10,0.7); }
  .contact-card--yellow:hover{ background: var(--c-yellow-dark); border-color: var(--c-yellow-dark); }
  .contact-card--red:hover{ border-color: rgba(230,57,70,0.5); box-shadow: 0 8px 32px rgba(230,57,70,0.18); }
  .contact-card__icon{
    width:44px; height:44px; border-radius:12px; display:grid; place-items:center;
    background: rgba(255,255,255,0.08); border:1px solid var(--c-border); flex-shrink:0;
    color: var(--c-white);
  }
  .contact-card--yellow .contact-card__icon{ background: var(--c-bg-900); color: var(--c-yellow); border-color: var(--c-bg-900); }
  .contact-card--blue .contact-card__icon{ background: var(--c-blue); color: var(--c-white); border-color: var(--c-blue); }
  .contact-card--red .contact-card__icon{ background: var(--c-red); color: var(--c-white); border-color: var(--c-red); }
  .contact-card--dark .contact-card__icon{ background: var(--c-bg-900); color: var(--c-white); }
  .contact-card__text{ flex:1; min-width:0; display:flex; flex-direction:column; line-height:1.25; }
  .contact-card__text strong{ font-size:0.95rem; color: var(--c-white); }
  .contact-card--yellow .contact-card__text strong{ color: var(--c-bg-900); }
  .contact-card__text span{ font-size:0.82rem; color: var(--c-muted); font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .contact-card__arrow{ font-size:1.1rem; color: var(--c-muted); }
  .contact-card__copy{
    font-size:0.72rem; font-weight:800; letter-spacing:0.06em; text-transform:uppercase;
    background: var(--c-bg-900); color: var(--c-white); padding:6px 10px; border-radius: var(--r-pill);
  }
  .contact-card--yellow .contact-card__copy{ background: var(--c-bg-900); color: var(--c-yellow); }

  .hablemos__actions{
    display:flex; flex-wrap:wrap; gap: var(--s-3); justify-content:center;
    margin-top: var(--s-8);
  }
  .hablemos__actions .btn{ padding:14px 22px; border-radius: var(--r-pill); font-weight:800; }
  .btn--yellow{ background: var(--c-yellow); color: var(--c-bg-900); border:2px solid var(--c-yellow); display:inline-flex; align-items:center; justify-content:center; text-decoration:none; }
  .btn--yellow:hover{ background: var(--c-yellow-dark); border-color: var(--c-yellow-dark); transform: translateY(-1px); }
  .btn--ghost{ background: transparent; color: var(--c-white); border:2px solid var(--c-border-strong); cursor:pointer; }
  .btn--ghost:hover{ background: rgba(255,255,255,0.08); border-color: var(--c-white); transform: translateY(-1px); }
  .hablemos__hint{ text-align:center; margin-top: var(--s-3); font-size:0.86rem; color: var(--c-yellow); font-weight:600; min-height:1.2em; }

  @media (max-width: 640px){
    .contact-card{ padding: var(--s-4); }
  }
</style>

<script>
  const hint = document.querySelector('.hablemos__hint');
  let hintTimer;

  function showHint(msg){
    if(!hint) return;
    hint.textContent = msg;
    clearTimeout(hintTimer);
    hintTimer = setTimeout(()=> hint.textContent = '', 2600);
  }

  async function copyText(text){
    try{
      if(navigator.clipboard?.writeText){
        await navigator.clipboard.writeText(text);
        showHint('✓ Copiado: ' + text);
      } else {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
        document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
        showHint('✓ Copiado: ' + text);
      }
    } catch{
      showHint('Copia manual: ' + text);
    }
  }

  document.querySelectorAll('[data-copy]').forEach(el=>{
    const text = el.getAttribute('data-copy');
    const doCopy = ()=> copyText(text);
    el.addEventListener('click', doCopy);
    el.addEventListener('keydown', (e)=>{
      if(e.key==='Enter' || e.key===' '){
        e.preventDefault(); doCopy();
      }
    });
  });
</script>
