---
interface Props {
  variant?: "default" | "red" | "blue" | "yellow" | "ghost";
}
const { variant = "default" } = Astro.props;
---

<span class={`badge badge--${variant}`}><slot /></span>

<style>
  .badge {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.02em;
    padding: 5px 10px; border-radius: var(--r-pill);
    border: 1px solid var(--c-border-strong);
    background: rgba(255,255,255,0.06);
    color: var(--c-text);
    white-space: nowrap; line-height: 1;
  }
  .badge--red { background: var(--c-red); color: var(--c-white); border-color: var(--c-red); }
  .badge--blue { background: var(--c-blue); color: var(--c-white); border-color: var(--c-blue); }
  .badge--yellow { background: var(--c-yellow); color: var(--c-bg-900); border-color: var(--c-yellow); font-weight:700; }
  .badge--ghost { background: transparent; border-color: var(--c-border-strong); color: var(--c-muted); }
</style>
